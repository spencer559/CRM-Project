<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Gives the app its own folder under Files > On My iPad, a natural home for the .crmdb.
	     Xcode has no generated-Info.plist build setting for this key; everything else is generated
	     from the INFOPLIST_KEY_* build settings and merged with this file. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<!-- Required for the app to be handed a file where it lives instead of a throwaway copy. The
	     open picker asks for open-in-place (asCopy: false) and some File Providers — OneDrive is
	     the one that bit us — won't hand over a usable in-place URL to an app that doesn't declare
	     this. Without it a picked OneDrive .crmdb fails to read at all. -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
